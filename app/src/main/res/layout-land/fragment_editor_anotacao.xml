<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="@color/background">


    <!-- ================================================= -->
    <!-- MENUS SUPERIORES -->
    <!-- ================================================= -->

    <LinearLayout
        android:id="@+id/layoutMenusSuperiores"

        android:layout_width="0dp"
        android:layout_height="wrap_content"

        android:background="@color/background"

        android:orientation="vertical"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">


        <!-- ================================================= -->
        <!-- TOP BAR COMPACTA -->
        <!-- ================================================= -->

        <LinearLayout
            android:id="@+id/topBar"

            android:layout_width="match_parent"
            android:layout_height="56dp"

            android:gravity="center_vertical"

            android:orientation="horizontal"

            android:paddingStart="12dp"
            android:paddingEnd="12dp">


            <!-- VOLTAR -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="40dp"
                android:layout_height="40dp"

                app:cardBackgroundColor="@color/surfaceVariant"

                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"

                app:strokeColor="@color/outlineVariant"
                app:strokeWidth="1dp">


                <ImageButton
                    android:id="@+id/btnVoltarEditor"

                    android:layout_width="match_parent"
                    android:layout_height="match_parent"

                    android:background="@android:color/transparent"

                    android:contentDescription="@string/voltar"

                    android:padding="10dp"

                    android:src="@drawable/seta_voltar"

                    app:tint="@color/primary" />

            </com.google.android.material.card.MaterialCardView>


            <!-- TÍTULO -->

            <EditText
                android:id="@+id/editTituloNota"

                android:layout_width="0dp"
                android:layout_height="match_parent"

                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"

                android:layout_weight="1"

                android:background="@null"

                android:fontFamily="@font/poppins_semibold"

                android:gravity="center_vertical"

                android:hint="Título da nota"

                android:maxLines="1"

                android:padding="0dp"

                android:textColor="@color/onSurface"
                android:textColorHint="@color/onSurfaceVariant"

                android:textSize="16sp" />


            <!-- EXPORTAR -->

            <ImageButton
                android:id="@+id/btnExportarNota"

                android:layout_width="38dp"
                android:layout_height="38dp"

                android:background="?attr/selectableItemBackgroundBorderless"

                android:contentDescription="Exportar"

                android:padding="9dp"

                android:src="@drawable/ic_share"

                app:tint="@color/onSurface" />


            <!-- SALVAR -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="40dp"
                android:layout_height="40dp"

                android:layout_marginStart="4dp"

                app:cardBackgroundColor="@color/primary"

                app:cardCornerRadius="12dp"

                app:cardElevation="0dp">


                <ImageButton
                    android:id="@+id/btnSalvarNota"

                    android:layout_width="match_parent"
                    android:layout_height="match_parent"

                    android:background="@android:color/transparent"

                    android:contentDescription="Salvar"

                    android:padding="10dp"

                    android:src="@drawable/ic_check"

                    app:tint="@color/onPrimary" />

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>


        <!-- DIVISOR -->

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"

            android:background="@color/outlineVariant" />


        <!-- ================================================= -->
        <!-- CONTROLES SUPERIORES -->
        <!-- ================================================= -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginStart="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="8dp"

            app:cardBackgroundColor="@color/surfaceVariant"

            app:cardCornerRadius="14dp"

            app:cardElevation="0dp"

            app:strokeColor="@color/outlineVariant"
            app:strokeWidth="1dp">


            <LinearLayout
                android:id="@+id/layoutControlesTopo"

                android:layout_width="match_parent"
                android:layout_height="48dp"

                android:gravity="center_vertical"

                android:orientation="horizontal"

                android:paddingStart="8dp"
                android:paddingEnd="8dp">


                <!-- FERRAMENTAS -->

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAbrirFerramentas"

                    style="@style/Widget.Material3.Button.TonalButton"

                    android:layout_width="wrap_content"
                    android:layout_height="36dp"

                    android:fontFamily="@font/poppins_medium"

                    android:text="Ferramentas"

                    android:textAllCaps="false"

                    android:textColor="@color/onPrimaryContainer"

                    android:textSize="10sp"

                    app:backgroundTint="@color/primaryContainer"

                    app:cornerRadius="10dp"

                    app:icon="@drawable/pencil"

                    app:iconPadding="5dp"
                    app:iconSize="16dp"

                    app:iconTint="@color/onPrimaryContainer" />


                <!-- MODO NAVEGAÇÃO -->

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnModoNavegacao"

                    style="@style/Widget.Material3.Button.IconButton"

                    android:layout_width="36dp"
                    android:layout_height="36dp"

                    android:layout_marginStart="6dp"

                    app:backgroundTint="@color/surface"

                    app:cornerRadius="10dp"

                    app:icon="@drawable/ic_panel_left_open"

                    app:iconGravity="textStart"

                    app:iconPadding="0dp"

                    app:iconSize="17dp"

                    app:iconTint="@color/onSurfaceVariant"

                    app:strokeColor="@color/outlineVariant"
                    app:strokeWidth="1dp" />


                <!-- DIVISOR -->

                <View
                    android:layout_width="1dp"
                    android:layout_height="22dp"

                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"

                    android:background="@color/outlineVariant" />


                <!-- ZOOM -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:fontFamily="@font/poppins_medium"

                    android:text="Zoom"

                    android:textColor="@color/onSurfaceVariant"

                    android:textSize="9sp" />


                <SeekBar
                    android:id="@+id/seekBarZoomCanvas"

                    android:layout_width="0dp"
                    android:layout_height="32dp"

                    android:layout_marginStart="6dp"

                    android:layout_weight="1"

                    android:max="300"

                    android:progress="50"

                    android:progressTint="@color/primary"

                    android:thumbTint="@color/primary" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>


    <!-- ================================================= -->
    <!-- BOTÃO RECOLHER (Visível quando menus abertos) -->
    <!-- ================================================= -->

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRecolherMenus"

        style="@style/Widget.Material3.Button.IconButton"

        android:layout_width="36dp"
        android:layout_height="36dp"

        android:layout_marginTop="-6dp"

        android:elevation="0dp"

        app:backgroundTint="@color/primaryContainer"

        app:cornerRadius="18dp"

        app:icon="@drawable/ic_up_arrow"

        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconSize="18dp"

        app:iconTint="@color/onPrimaryContainer"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutMenusSuperiores" />


    <!-- ================================================= -->
    <!-- BOTÃO EXPANDIR (Visível quando menus ocultos) -->
    <!-- ================================================= -->

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnExpandirMenus"

        style="@style/Widget.Material3.Button.IconButton"

        android:layout_width="36dp"
        android:layout_height="36dp"

        android:layout_marginTop="12dp"

        android:elevation="2dp"

        android:visibility="gone"

        app:backgroundTint="@color/surfaceVariant"

        app:cornerRadius="18dp"

        app:icon="@drawable/ic_down"

        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconSize="18dp"

        app:iconTint="@color/primary"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"

        app:strokeColor="@color/outlineVariant"
        app:strokeWidth="1dp" />


    <!-- ================================================= -->
    <!-- ÁREA DO CANVAS -->
    <!-- ================================================= -->

    <FrameLayout
        android:id="@+id/containerEditor"

        android:layout_width="0dp"
        android:layout_height="0dp"

        android:layout_marginStart="10dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="8dp"

        android:background="@color/surface"

        android:clipChildren="true"

        app:layout_constraintBottom_toTopOf="@+id/layoutControlesDesenho"

        app:layout_constraintEnd_toEndOf="parent"

        app:layout_constraintStart_toStartOf="parent"

        app:layout_constraintTop_toBottomOf="@+id/layoutMenusSuperiores">


        <RelativeLayout
            android:id="@+id/canvasNotas"

            android:layout_width="3000dp"
            android:layout_height="3000dp"

            android:background="@color/surface" />


        <com.example.studyflow.DesenhoView
            android:id="@+id/desenhoViewSobreposto"

            android:layout_width="match_parent"
            android:layout_height="213dp"

            android:visibility="visible" />

    </FrameLayout>


    <!-- ================================================= -->
    <!-- BARRA DE DESENHO -->
    <!-- ================================================= -->

    <LinearLayout
        android:id="@+id/layoutControlesDesenho"

        android:layout_width="0dp"
        android:layout_height="wrap_content"

        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="8dp"

        android:background="@drawable/bg_editor_toolbar"

        android:orientation="vertical"

        android:paddingStart="8dp"
        android:paddingTop="5dp"
        android:paddingEnd="8dp"
        android:paddingBottom="5dp"

        android:visibility="visible"

        app:layout_constraintBottom_toBottomOf="parent"

        app:layout_constraintEnd_toEndOf="parent"

        app:layout_constraintStart_toStartOf="parent">


        <!-- ================================================= -->
        <!-- AÇÕES PRINCIPAIS -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"

            android:gravity="center_vertical"

            android:orientation="horizontal">


            <!-- DESFAZER -->

            <ImageButton
                android:id="@+id/btnDesfazer"

                android:layout_width="36dp"
                android:layout_height="36dp"

                android:background="?attr/selectableItemBackgroundBorderless"

                android:contentDescription="Desfazer"

                android:padding="8dp"

                android:src="@drawable/ic_desfazer"

                app:tint="@color/onSurfaceVariant" />


            <!-- REFAZER -->

            <ImageButton
                android:id="@+id/btnRefazer"

                android:layout_width="36dp"
                android:layout_height="36dp"

                android:layout_marginStart="2dp"

                android:background="?attr/selectableItemBackgroundBorderless"

                android:contentDescription="Refazer"

                android:padding="8dp"

                android:src="@drawable/ic_refazer"

                app:tint="@color/onSurfaceVariant" />


            <!-- DIVISOR -->

            <View
                android:layout_width="1dp"
                android:layout_height="20dp"

                android:layout_marginStart="7dp"
                android:layout_marginEnd="7dp"

                android:background="@color/outlineVariant" />


            <!-- PINCEL -->

            <ImageButton
                android:id="@+id/btnPincel"

                android:layout_width="36dp"
                android:layout_height="36dp"

                android:background="?attr/selectableItemBackgroundBorderless"

                android:contentDescription="Pincel"

                android:padding="8dp"

                android:src="@drawable/pencil"

                app:tint="@color/primary" />


            <!-- BORRACHA -->

            <ImageButton
                android:id="@+id/btnBorracha"

                android:layout_width="36dp"
                android:layout_height="36dp"

                android:layout_marginStart="2dp"

                android:background="?attr/selectableItemBackgroundBorderless"

                android:contentDescription="Borracha"

                android:padding="8dp"

                android:src="@drawable/ic_trash"

                app:tint="@color/error" />


            <!-- ESPAÇADOR -->

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"

                android:layout_weight="1" />


            <!-- CONCLUIR -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConcluirDesenho"

                style="@style/Widget.Material3.Button.TonalButton"

                android:layout_width="wrap_content"
                android:layout_height="32dp"

                android:fontFamily="@font/poppins_semibold"

                android:minWidth="0dp"

                android:text="Concluir"

                android:textAllCaps="false"

                android:textColor="@color/onPrimaryContainer"

                android:textSize="10sp"

                android:visibility="gone"

                app:backgroundTint="@color/primaryContainer"

                app:cornerRadius="10dp" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- OPÇÕES EXPANDIDAS -->
        <!-- ================================================= -->

        <LinearLayout
            android:id="@+id/layoutOpcoesFerramenta"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="2dp"

            android:orientation="vertical"

            android:visibility="gone">


            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"

                android:layout_marginBottom="4dp"

                android:background="@color/outlineVariant" />


            <!-- ================================================= -->
            <!-- ESPESSURA -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="36dp"

                android:gravity="center_vertical"

                android:orientation="horizontal">


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:fontFamily="@font/poppins_medium"

                    android:text="Tamanho"

                    android:textColor="@color/onSurfaceVariant"

                    android:textSize="9sp" />


                <SeekBar
                    android:id="@+id/seekBarEspessura"

                    android:layout_width="150dp"
                    android:layout_height="30dp"

                    android:layout_marginStart="6dp"

                    android:max="50"

                    android:progress="10"

                    android:progressTint="@color/primary"

                    android:thumbTint="@color/primary" />


                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"

                    android:layout_weight="1" />


                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLimparCanvas"

                    style="@style/Widget.Material3.Button.TextButton"

                    android:layout_width="wrap_content"
                    android:layout_height="32dp"

                    android:fontFamily="@font/poppins_medium"

                    android:minWidth="0dp"

                    android:text="Limpar"

                    android:textAllCaps="false"

                    android:textColor="@color/error"

                    android:textSize="9sp" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- CORES -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="34dp"

                android:gravity="center_vertical"

                android:orientation="horizontal">


                <SeekBar
                    android:id="@+id/seekBarCorArcoIrisDesenho"

                    android:layout_width="130dp"
                    android:layout_height="28dp"

                    android:max="360"

                    android:progressDrawable="@null" />


                <View
                    android:layout_width="1dp"
                    android:layout_height="20dp"

                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"

                    android:background="@color/outlineVariant" />


                <HorizontalScrollView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"

                    android:layout_weight="1"

                    android:fillViewport="false"

                    android:scrollbars="none">


                    <LinearLayout
                        android:id="@+id/layoutCoresDesenho"

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:gravity="center_vertical"

                        android:orientation="horizontal" />

                </HorizontalScrollView>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>