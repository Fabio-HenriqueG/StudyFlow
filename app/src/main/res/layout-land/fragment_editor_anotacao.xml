<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <!-- Top Bar compacta para modo Paisagem -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="4dp"
        android:gravity="center_vertical"
        android:background="?attr/colorSurface"
        android:elevation="2dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnVoltarEditor"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/seta_voltar"
            app:tint="?attr/colorOnSurface" />

        <EditText
            android:id="@+id/editTituloNota"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@null"
            android:hint="Título"
            android:textColor="?attr/colorOnSurface"
            android:textSize="18sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAbrirFerramentas"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="Ferramentas"
            android:textSize="12sp"
            app:iconSize="16dp"
            app:icon="@android:drawable/ic_menu_edit" />

        <ImageButton
            android:id="@+id/btnSalvarNota"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_check"
            app:tint="?attr/colorPrimary" />
    </LinearLayout>

    <!-- Área Principal de Edição -->
    <FrameLayout
        android:id="@+id/containerEditor"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:background="@android:color/white"
        android:clipChildren="true"
        app:layout_constraintBottom_toTopOf="@+id/seekBarNavX"
        app:layout_constraintEnd_toStartOf="@+id/seekBarZoomCanvas"
        app:layout_constraintStart_toEndOf="@+id/seekBarNavY"
        app:layout_constraintTop_toBottomOf="@+id/topBar">

        <RelativeLayout
            android:id="@+id/canvasNotas"
            android:layout_width="2000dp"
            android:layout_height="3000dp"
            android:background="@android:color/transparent" />

        <com.example.studyflow.DesenhoView
            android:id="@+id/desenhoViewSobreposto"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Barras de Controle Reduzidas para Paisagem -->

    <SeekBar
        android:id="@+id/seekBarNavY"
        android:layout_width="150dp"
        android:layout_height="32dp"
        android:layout_marginStart="-60dp"
        android:alpha="0.5"
        android:max="3000"
        android:progress="0"
        android:rotation="270"
        app:layout_constraintBottom_toBottomOf="@+id/containerEditor"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/containerEditor" />

    <SeekBar
        android:id="@+id/seekBarZoomCanvas"
        android:layout_width="150dp"
        android:layout_height="32dp"
        android:layout_marginEnd="-60dp"
        android:alpha="0.5"
        android:max="400"
        android:progress="100"
        android:rotation="270"
        app:layout_constraintBottom_toBottomOf="@+id/containerEditor"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/containerEditor" />

    <SeekBar
        android:id="@+id/seekBarNavX"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:layout_marginBottom="4dp"
        android:alpha="0.5"
        android:max="2000"
        android:progress="0"
        app:layout_constraintBottom_toTopOf="@+id/layoutControlesDesenho"
        app:layout_constraintEnd_toEndOf="@+id/containerEditor"
        app:layout_constraintStart_toStartOf="@+id/containerEditor" />

    <!-- Barra de Desenho (Sobreposta ao rodapé em paisagem) -->
    <LinearLayout
        android:id="@+id/layoutControlesDesenho"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceVariant"
        android:orientation="horizontal"
        android:padding="4dp"
        android:visibility="gone"
        android:gravity="center_vertical"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:text="T:"
            android:textSize="10sp" />

        <SeekBar
            android:id="@+id/seekBarEspessura"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:max="50"
            android:progress="10" />

        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/layoutCoresDesenho"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLimparCanvas"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Limpar"
            android:textSize="10sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConcluirDesenho"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OK" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
