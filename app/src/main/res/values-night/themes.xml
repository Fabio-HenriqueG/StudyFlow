<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme for Dark Mode. -->
    <style name="Base.Theme.StudyFlow" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">#A1C9FF</item>
        <item name="colorOnPrimary">#003258</item>
        <item name="colorPrimaryContainer">#00497D</item>
        <item name="colorOnPrimaryContainer">#D1E4FF</item>

        <!-- Secondary brand color. -->
        <item name="colorSecondary">#BBC7DB</item>
        <item name="colorOnSecondary">#253140</item>
        <item name="colorSecondaryContainer">#3B4858</item>
        <item name="colorOnSecondaryContainer">#D7E3F9</item>

        <!-- Background and Surface colors. -->
        <item name="android:windowBackground">#1B1B1F</item>
        <item name="colorSurface">#1B1B1F</item>
        <item name="colorOnSurface">#E3E2E6</item>
        <item name="colorSurfaceVariant">#44474E</item>
        <item name="colorOnSurfaceVariant">#C4C6D0</item>

        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="ThemeOverlay.App.BottomNav" parent="">
        <item name="colorSecondaryContainer">@color/nav_indicador</item>
    </style>
</resources>
