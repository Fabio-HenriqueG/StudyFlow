<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="6dp"

    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"

    app:cardBackgroundColor="@color/surfaceVariant"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"

    app:strokeColor="@color/outlineVariant"
    app:strokeWidth="1dp">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:gravity="center_vertical"

        android:orientation="horizontal"

        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="14dp">


        <!-- INDICADOR DA COR DA MATÉRIA -->

        <View
            android:id="@+id/viewCorMateria"

            android:layout_width="10dp"
            android:layout_height="42dp"

            android:background="@drawable/bg_indicador_materia" />


        <!-- INFORMAÇÕES -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_marginStart="14dp"

            android:layout_weight="1"

            android:orientation="vertical">


            <TextView
                android:id="@+id/txtNomeMateria"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:ellipsize="end"
                android:maxLines="1"

                android:fontFamily="@font/poppins_semibold"

                android:text="Nome da Matéria"

                android:textColor="@color/onSurface"
                android:textSize="14sp" />


            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginTop="5dp"

                android:gravity="center_vertical"

                android:orientation="horizontal">


                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"

                    android:contentDescription="@null"

                    android:src="@drawable/ic_card"

                    app:tint="@color/onSurface" />


                <TextView
                    android:id="@+id/txtQtdFlashcards"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginStart="6dp"

                    android:fontFamily="@font/poppins_regular"

                    android:text="12 cartões"

                    android:textColor="@color/onSurfaceVariant"
                    android:textSize="10sp" />

            </LinearLayout>

        </LinearLayout>


        <!-- SETA -->

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"

            android:layout_marginStart="12dp"

            android:contentDescription="@null"

            android:src="@drawable/ic_skip_forward"

            app:tint="@color/onSurface" />


    </LinearLayout>

</com.google.android.material.card.MaterialCardView>