<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:background="@color/surface"

    android:orientation="vertical"

    android:paddingStart="20dp"
    android:paddingTop="8dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">


    <!-- ALÇA -->

    <com.google.android.material.bottomsheet.BottomSheetDragHandleView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:layout_marginBottom="12dp" />


    <!-- TÍTULO -->

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:fontFamily="@font/poppins_semibold"

        android:text="O que você deseja criar?"

        android:textColor="@color/onSurface"

        android:textSize="20sp" />


    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:layout_marginTop="3dp"
        android:layout_marginBottom="20dp"

        android:fontFamily="@font/poppins_regular"

        android:text="Escolha o tipo de conteúdo que deseja adicionar"

        android:textColor="@color/onSurfaceVariant"

        android:textSize="12sp" />


    <!-- ================================================= -->
    <!-- TAREFA -->
    <!-- ================================================= -->

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_menu_tarefa"

        style="@style/Widget.Material3.Button.TonalButton"

        android:layout_width="match_parent"
        android:layout_height="58dp"

        android:layout_marginBottom="9dp"

        android:fontFamily="@font/poppins_medium"

        android:gravity="center_vertical"

        android:paddingStart="16dp"
        android:paddingEnd="16dp"

        android:text="Nova Tarefa"
        android:textAllCaps="false"

        android:textColor="@color/primary"

        android:textSize="13sp"

        app:backgroundTint="@color/primaryContainer"

        app:cornerRadius="16dp"

        app:icon="@drawable/ic_tarefas"

        app:iconGravity="textStart"

        app:iconPadding="12dp"

        app:iconSize="21dp"

        app:iconTint="@color/primary" />


    <!-- ================================================= -->
    <!-- CADERNO LIVRE -->
    <!-- ================================================= -->

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_menu_anotacao"

        style="@style/Widget.Material3.Button.TonalButton"

        android:layout_width="match_parent"
        android:layout_height="58dp"

        android:layout_marginBottom="9dp"

        android:fontFamily="@font/poppins_medium"

        android:gravity="center_vertical"

        android:paddingStart="16dp"
        android:paddingEnd="16dp"

        android:text="Caderno Livre"

        android:textAllCaps="false"

        android:textColor="@color/primary"

        android:textSize="13sp"

        app:backgroundTint="@color/primaryContainer"

        app:cornerRadius="16dp"

        app:icon="@drawable/ic_pencil"

        app:iconGravity="textStart"

        app:iconPadding="12dp"

        app:iconSize="21dp"

        app:iconTint="@color/onPrimaryContainer" />


    <!-- ================================================= -->
    <!-- BLOCO DE NOTAS -->
    <!-- ================================================= -->

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_menu_bloco_notas"

        style="@style/Widget.Material3.Button.TonalButton"

        android:layout_width="match_parent"
        android:layout_height="58dp"

        android:layout_marginBottom="9dp"

        android:fontFamily="@font/poppins_medium"

        android:gravity="center_vertical"

        android:paddingStart="16dp"
        android:paddingEnd="16dp"

        android:text="Bloco de Notas"

        android:textAllCaps="false"

        android:textColor="@color/onPrimaryContainer"

        android:textSize="13sp"

        app:backgroundTint="@color/primaryContainer"

        app:cornerRadius="16dp"

        app:icon="@drawable/ic_anotacoes"

        app:iconGravity="textStart"

        app:iconPadding="12dp"

        app:iconSize="21dp"

        app:iconTint="@color/onPrimaryContainer" />


    <!-- ================================================= -->
    <!-- META -->
    <!-- ================================================= -->

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_menu_meta"

        style="@style/Widget.Material3.Button.TonalButton"

        android:layout_width="match_parent"
        android:layout_height="58dp"

        android:layout_marginBottom="9dp"

        android:fontFamily="@font/poppins_medium"

        android:gravity="center_vertical"

        android:paddingStart="16dp"
        android:paddingEnd="16dp"

        android:text="Nova Meta"

        android:textAllCaps="false"

        android:textColor="@color/onPrimaryContainer"

        android:textSize="13sp"

        app:backgroundTint="@color/primaryContainer"

        app:cornerRadius="16dp"

        app:icon="@drawable/ic_target"

        app:iconGravity="textStart"

        app:iconPadding="12dp"

        app:iconSize="21dp"

        app:iconTint="@color/onPrimaryContainer" />


    <!-- ================================================= -->
    <!-- CHECKLIST -->
    <!-- ================================================= -->

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_menu_checklist"

        style="@style/Widget.Material3.Button.TonalButton"

        android:layout_width="match_parent"
        android:layout_height="58dp"

        android:layout_marginBottom="9dp"

        android:fontFamily="@font/poppins_medium"

        android:gravity="center_vertical"

        android:paddingStart="16dp"
        android:paddingEnd="16dp"

        android:text="Novo Checklist"

        android:textAllCaps="false"

        android:textColor="@color/primary"

        android:textSize="13sp"

        app:backgroundTint="@color/primaryContainer"

        app:cornerRadius="16dp"

        app:icon="@drawable/ic_checklist"

        app:iconGravity="textStart"

        app:iconPadding="12dp"

        app:iconSize="21dp"

        app:iconTint="@color/primary" />


    <!-- ================================================= -->
    <!-- FLASHCARD -->
    <!-- ================================================= -->

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_menu_flashcard"

        style="@style/Widget.Material3.Button.TonalButton"

        android:layout_width="match_parent"
        android:layout_height="58dp"

        android:fontFamily="@font/poppins_medium"

        android:gravity="center_vertical"

        android:paddingStart="16dp"
        android:paddingEnd="16dp"

        android:text="Novo Flashcard"

        android:textAllCaps="false"

        android:textColor="@color/onPrimaryContainer"

        android:textSize="13sp"

        app:backgroundTint="@color/primaryContainer"

        app:cornerRadius="16dp"

        app:icon="@drawable/ic_card"

        app:iconGravity="textStart"

        app:iconPadding="12dp"

        app:iconSize="21dp"

        app:iconTint="@color/onPrimaryContainer" />

</LinearLayout>