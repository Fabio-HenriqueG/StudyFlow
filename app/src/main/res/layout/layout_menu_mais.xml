<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="@android:color/white">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="O que você deseja criar?"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btn_menu_tarefa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nova Tarefa"
            android:backgroundTint="#4CAF50"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btn_menu_anotacao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nova Anotação"
            android:backgroundTint="#2196F3"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btn_menu_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nova Meta"
            android:backgroundTint="#FF9800"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btn_menu_checklist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Novo Checklist"
            android:backgroundTint="#9C27B0"/>

</LinearLayout>
