<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="@color/background"

    android:paddingStart="20dp"
    android:paddingTop="22dp"
    android:paddingEnd="20dp">


    <!-- ================================================= -->
    <!-- BOTÃO VOLTAR -->
    <!-- ================================================= -->

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardVoltarHistorico"

        android:layout_width="44dp"
        android:layout_height="44dp"

        app:cardBackgroundColor="@color/surfaceVariant"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"

        app:strokeColor="@color/outlineVariant"
        app:strokeWidth="1dp"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">


        <ImageButton
            android:id="@+id/btn_voltar_historico"

            android:layout_width="match_parent"
            android:layout_height="match_parent"

            android:background="@android:color/transparent"

            android:contentDescription="@string/voltar"

            android:padding="11dp"

            android:src="@drawable/seta_voltar"

            app:tint="@color/primary" />

    </com.google.android.material.card.MaterialCardView>


    <!-- ================================================= -->
    <!-- TÍTULO -->
    <!-- ================================================= -->

    <TextView
        android:id="@+id/lblHistorico"

        android:layout_width="0dp"
        android:layout_height="wrap_content"

        android:layout_marginStart="12dp"

        android:fontFamily="@font/poppins_semibold"

        android:text="@string/historico_tarefas"

        android:textColor="@color/onSurface"
        android:textSize="22sp"

        app:layout_constraintBottom_toBottomOf="@+id/cardVoltarHistorico"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/cardVoltarHistorico"
        app:layout_constraintTop_toTopOf="@+id/cardVoltarHistorico" />


    <!-- ================================================= -->
    <!-- SUBTÍTULO -->
    <!-- ================================================= -->

    <TextView
        android:id="@+id/lblDescricaoHistorico"

        android:layout_width="0dp"
        android:layout_height="wrap_content"

        android:layout_marginTop="10dp"

        android:fontFamily="@font/poppins_regular"

        android:text="Veja as tarefas que você já concluiu"

        android:textColor="@color/onSurfaceVariant"
        android:textSize="12sp"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cardVoltarHistorico" />


    <!-- ================================================= -->
    <!-- LISTA DO HISTÓRICO -->
    <!-- ================================================= -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerHistorico"

        android:layout_width="0dp"
        android:layout_height="0dp"

        android:layout_marginTop="20dp"

        android:clipToPadding="false"

        android:paddingTop="2dp"
        android:paddingBottom="32dp"

        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/lblDescricaoHistorico"

        tools:listitem="@layout/item_tarefa" />


</androidx.constraintlayout.widget.ConstraintLayout>