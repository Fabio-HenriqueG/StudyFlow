<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="@color/background"

    android:paddingStart="20dp"
    android:paddingTop="22dp"
    android:paddingEnd="20dp">


    <!-- ================================================= -->
    <!-- VOLTAR -->
    <!-- ================================================= -->

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardVoltarListaFlash"

        android:layout_width="44dp"
        android:layout_height="44dp"

        app:cardBackgroundColor="@color/surfaceVariant"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"

        app:strokeColor="@color/outlineVariant"
        app:strokeWidth="1dp"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">


        <ImageButton
            android:id="@+id/btnVoltarListaFlash"

            android:layout_width="match_parent"
            android:layout_height="match_parent"

            android:background="@android:color/transparent"

            android:contentDescription="@string/voltar"

            android:padding="11dp"

            android:src="@drawable/seta_voltar"

            app:tint="@color/primary" />

    </com.google.android.material.card.MaterialCardView>


    <!-- ================================================= -->
    <!-- ESTATÍSTICAS / ORDENAÇÃO -->
    <!-- ================================================= -->

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardStatsFlash"

        android:layout_width="44dp"
        android:layout_height="44dp"

        app:cardBackgroundColor="@color/surfaceVariant"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"

        app:strokeColor="@color/outlineVariant"
        app:strokeWidth="1dp"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">


        <ImageButton
            android:id="@+id/btnVerStats"

            android:layout_width="match_parent"
            android:layout_height="match_parent"

            android:background="@android:color/transparent"

            android:contentDescription="Ver estatísticas"

            android:padding="11dp"

            android:src="@drawable/ic_list_sort_descending"

            app:tint="@color/primary" />

    </com.google.android.material.card.MaterialCardView>


    <!-- ================================================= -->
    <!-- TÍTULO -->
    <!-- ================================================= -->

    <TextView
        android:id="@+id/lblTituloListaFlash"

        android:layout_width="0dp"
        android:layout_height="wrap_content"

        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"

        android:fontFamily="@font/poppins_semibold"

        android:text="Meus Flashcards"

        android:textColor="@color/onSurface"
        android:textSize="22sp"

        app:layout_constraintBottom_toBottomOf="@+id/cardVoltarListaFlash"
        app:layout_constraintEnd_toStartOf="@+id/cardStatsFlash"
        app:layout_constraintStart_toEndOf="@+id/cardVoltarListaFlash"
        app:layout_constraintTop_toTopOf="@+id/cardVoltarListaFlash" />


    <!-- ================================================= -->
    <!-- SUBTÍTULO -->
    <!-- ================================================= -->

    <TextView
        android:id="@+id/lblDescricaoListaFlash"

        android:layout_width="0dp"
        android:layout_height="wrap_content"

        android:layout_marginTop="10dp"

        android:fontFamily="@font/poppins_regular"

        android:text="Revise seus cartões e acompanhe seu aprendizado"

        android:textColor="@color/onSurfaceVariant"
        android:textSize="12sp"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cardVoltarListaFlash" />


    <!-- ================================================= -->
    <!-- LISTA DE FLASHCARDS -->
    <!-- ================================================= -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerListaFlashcards"

        android:layout_width="0dp"
        android:layout_height="0dp"

        android:layout_marginTop="20dp"

        android:clipToPadding="false"

        android:paddingTop="2dp"
        android:paddingBottom="32dp"

        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/lblDescricaoListaFlash"

        tools:listitem="@layout/item_flashcard_lista" />

    <LinearLayout
        android:id="@+id/layoutEmptyFlashcards"

        android:layout_width="0dp"
        android:layout_height="wrap_content"

        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/lblDescricaoListaFlash">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_semibold"
            android:gravity="center"
            android:text="Nenhum flashcard criado!\nVamos criar?"
            android:textColor="@color/onSurface"
            android:textSize="14sp" />

    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>