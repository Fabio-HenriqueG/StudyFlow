<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:id="@+id/cardChecklist"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="6dp"

    app:cardBackgroundColor="@color/surfaceVariant"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"

    app:strokeColor="@color/outlineVariant"
    app:strokeWidth="1dp">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="12dp"
        android:paddingBottom="14dp">


        <!-- PIN -->

        <ImageView
            android:id="@+id/img_pin"

            android:layout_width="16dp"
            android:layout_height="16dp"

            android:contentDescription="Checklist fixada"

            android:src="@drawable/ic_pin"

            android:visibility="gone"

            app:tint="@color/primary"

            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/text_checklist_titulo"
            app:layout_constraintBottom_toBottomOf="@id/text_checklist_titulo" />


        <!-- TÍTULO -->

        <TextView
            android:id="@+id/text_checklist_titulo"

            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_marginStart="6dp"
            android:layout_marginEnd="8dp"

            android:ellipsize="end"
            android:maxLines="2"

            android:fontFamily="@font/poppins_semibold"

            android:text="Lista de Compras"

            android:textColor="@color/onSurface"

            android:textSize="14sp"

            app:layout_goneMarginStart="0dp"

            app:layout_constraintStart_toEndOf="@id/img_pin"
            app:layout_constraintEnd_toStartOf="@id/btn_opcoes_checklist"
            app:layout_constraintTop_toTopOf="parent" />


        <!-- OPÇÕES -->

        <ImageButton
            android:id="@+id/btn_opcoes_checklist"

            android:layout_width="36dp"
            android:layout_height="36dp"

            android:background="?attr/selectableItemBackgroundBorderless"

            android:contentDescription="Opções"

            android:padding="8dp"

            android:src="@drawable/ic_more_vert"

            app:tint="@color/onSurfaceVariant"

            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <!-- PROGRESSO -->

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress_checklist"

            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_marginTop="16dp"
            android:layout_marginEnd="12dp"

            android:progress="0"

            app:indicatorColor="@color/primary"

            app:trackColor="@color/primaryContainer"
            app:trackCornerRadius="3dp"
            app:trackThickness="6dp"

            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/text_checklist_porcentagem"
            app:layout_constraintTop_toBottomOf="@id/text_checklist_titulo" />


        <!-- PORCENTAGEM -->

        <TextView
            android:id="@+id/text_checklist_porcentagem"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:minWidth="32dp"

            android:fontFamily="@font/poppins_medium"

            android:gravity="end"

            android:text="0%"

            android:textColor="@color/primary"

            android:textSize="11sp"

            app:layout_constraintStart_toEndOf="@id/progress_checklist"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/progress_checklist"
            app:layout_constraintBottom_toBottomOf="@id/progress_checklist" />


        <!-- VALIDADE -->

        <TextView
            android:id="@+id/text_checklist_validade"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="10dp"

            android:fontFamily="@font/poppins_medium"

            android:text="Expira em: --/--"

            android:textColor="@color/error"

            android:textSize="10sp"

            android:visibility="gone"

            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/progress_checklist" />


    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>