<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="@color/background"
    android:fillViewport="true"

    tools:context=".DashboardFragment">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:paddingStart="20dp"
        android:paddingTop="22dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">


        <!-- ===================================================== -->
        <!-- CABEÇALHO -->
        <!-- ===================================================== -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardVoltarDashboard"

            android:layout_width="44dp"
            android:layout_height="44dp"

            app:cardBackgroundColor="@color/surfaceVariant"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"

            app:strokeColor="@color/outlineVariant"
            app:strokeWidth="1dp"

            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">


            <ImageButton
                android:id="@+id/btnVoltarDashboard"

                android:layout_width="match_parent"
                android:layout_height="match_parent"

                android:background="@android:color/transparent"

                android:contentDescription="Voltar"

                android:padding="11dp"

                android:src="@drawable/seta_voltar"

                app:tint="@color/primary" />

        </com.google.android.material.card.MaterialCardView>


        <TextView
            android:id="@+id/lblTituloDashboard"

            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_marginEnd="12dp"

            android:fontFamily="@font/poppins_semibold"

            android:text="Dashboard Geral"

            android:textColor="@color/onSurface"
            android:textSize="22sp"

            app:layout_constraintBottom_toBottomOf="@+id/cardVoltarDashboard"
            app:layout_constraintEnd_toStartOf="@+id/cardVoltarDashboard"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/cardVoltarDashboard" />


        <TextView
            android:id="@+id/lblDescricaoDashboard"

            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_marginTop="4dp"

            android:fontFamily="@font/poppins_regular"

            android:text="Acompanhe seu desempenho nos estudos"

            android:textColor="@color/onSurfaceVariant"
            android:textSize="12sp"

            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/lblTituloDashboard" />


        <!-- ===================================================== -->
        <!-- PERÍODO -->
        <!-- ===================================================== -->

        <TextView
            android:id="@+id/lblPeriodoDashboard"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="26dp"

            android:fontFamily="@font/poppins_semibold"

            android:text="Período"

            android:textColor="@color/primary"
            android:textSize="13sp"

            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/lblDescricaoDashboard" />


        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleGroupPeriodo"

            android:layout_width="0dp"
            android:layout_height="44dp"

            android:layout_marginTop="8dp"

            app:selectionRequired="true"
            app:singleSelection="true"

            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/lblPeriodoDashboard">


            <Button
                android:id="@+id/btnPeriodoHoje"

                style="?attr/materialButtonOutlinedStyle"

                android:layout_width="0dp"
                android:layout_height="44dp"

                android:layout_weight="1"

                android:fontFamily="@font/poppins_medium"

                android:text="Hoje"
                android:textAllCaps="false"
                android:textSize="10sp" />


            <Button
                android:id="@+id/btnPeriodoOntem"

                style="?attr/materialButtonOutlinedStyle"

                android:layout_width="0dp"
                android:layout_height="44dp"

                android:layout_weight="1"

                android:fontFamily="@font/poppins_medium"

                android:text="Ontem"
                android:textAllCaps="false"
                android:textSize="10sp" />


            <Button
                android:id="@+id/btnPeriodoSemana"

                style="?attr/materialButtonOutlinedStyle"

                android:layout_width="0dp"
                android:layout_height="44dp"

                android:layout_weight="1"

                android:fontFamily="@font/poppins_medium"

                android:text="Semana"
                android:textAllCaps="false"
                android:textSize="10sp" />


            <Button
                android:id="@+id/btnPeriodoMes"

                style="?attr/materialButtonOutlinedStyle"

                android:layout_width="0dp"
                android:layout_height="44dp"

                android:layout_weight="1"

                android:fontFamily="@font/poppins_medium"

                android:text="Mês"
                android:textAllCaps="false"
                android:textSize="10sp" />

        </com.google.android.material.button.MaterialButtonToggleGroup>


        <!-- ===================================================== -->
        <!-- ATIVIDADE RECENTE -->
        <!-- ===================================================== -->

        <TextView
            android:id="@+id/lblAtividadeGeral"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="28dp"

            android:fontFamily="@font/poppins_semibold"

            android:text="Atividade recente"

            android:textColor="@color/onSurface"
            android:textSize="17sp"

            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/toggleGroupPeriodo" />


        <TextView
            android:id="@+id/lblAtividadeDescricao"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="2dp"

            android:fontFamily="@font/poppins_regular"

            android:text="Últimos 7 dias"

            android:textColor="@color/onSurfaceVariant"
            android:textSize="10sp"

            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/lblAtividadeGeral" />


        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardGraficoAtividade"

            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_marginTop="10dp"

            app:cardBackgroundColor="@color/surfaceVariant"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"

            app:strokeColor="@color/outlineVariant"
            app:strokeWidth="1dp"

            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/lblAtividadeDescricao">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="vertical"

                android:paddingStart="18dp"
                android:paddingTop="18dp"
                android:paddingEnd="18dp"
                android:paddingBottom="14dp">


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:fontFamily="@font/poppins_medium"

                    android:text="Ritmo de estudos"

                    android:textColor="@color/onSurface"
                    android:textSize="12sp" />


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="2dp"

                    android:fontFamily="@font/poppins_regular"

                    android:text="Sua atividade ao longo da semana"

                    android:textColor="@color/onSurfaceVariant"
                    android:textSize="10sp" />


                <LinearLayout
                    android:id="@+id/layoutCargaSemanaGeral"

                    android:layout_width="match_parent"
                    android:layout_height="120dp"

                    android:layout_marginTop="16dp"

                    android:gravity="bottom"

                    android:orientation="horizontal"

                    android:weightSum="7" />


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="8dp"

                    android:orientation="horizontal"

                    android:weightSum="7">


                    <TextView
                        style="@style/DayStatsLabel"
                        android:text="D" />

                    <TextView
                        style="@style/DayStatsLabel"
                        android:text="S" />

                    <TextView
                        style="@style/DayStatsLabel"
                        android:text="T" />

                    <TextView
                        style="@style/DayStatsLabel"
                        android:text="Q" />

                    <TextView
                        style="@style/DayStatsLabel"
                        android:text="Q" />

                    <TextView
                        style="@style/DayStatsLabel"
                        android:text="S" />

                    <TextView
                        style="@style/DayStatsLabel"
                        android:text="S" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- ===================================================== -->
        <!-- TAREFAS -->
        <!-- ===================================================== -->

        <TextView
            android:id="@+id/lblTarefasStats"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="26dp"

            android:fontFamily="@font/poppins_semibold"

            android:text="Tarefas concluídas"

            android:textColor="@color/onSurface"
            android:textSize="17sp"

            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cardGraficoAtividade" />


        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardTarefasStats"

            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_marginTop="10dp"

            app:cardBackgroundColor="@color/surfaceVariant"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"

            app:strokeColor="@color/outlineVariant"
            app:strokeWidth="1dp"

            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/lblTarefasStats">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="vertical"

                android:padding="18dp">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:gravity="center_vertical"

                    android:orientation="horizontal">


                    <TextView
                        android:id="@+id/txtCountTarefas"

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:fontFamily="@font/poppins_semibold"

                        android:text="0"

                        android:textColor="@color/primary"
                        android:textSize="30sp" />


                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:layout_marginStart="10dp"

                        android:orientation="vertical">


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:fontFamily="@font/poppins_medium"

                            android:text="Tarefas"

                            android:textColor="@color/onSurface"
                            android:textSize="11sp" />


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:fontFamily="@font/poppins_regular"

                            android:text="Total no período"

                            android:textColor="@color/onSurfaceVariant"
                            android:textSize="9sp" />

                    </LinearLayout>

                </LinearLayout>


                <LinearLayout
                    android:id="@+id/layoutCargaTarefas"

                    android:layout_width="match_parent"
                    android:layout_height="64dp"

                    android:layout_marginTop="14dp"

                    android:gravity="bottom"

                    android:orientation="horizontal"

                    android:weightSum="7" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- ===================================================== -->
        <!-- METAS -->
        <!-- ===================================================== -->

        <TextView
            android:id="@+id/lblMetasStats"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="26dp"

            android:fontFamily="@font/poppins_semibold"

            android:text="Metas atualizadas"

            android:textColor="@color/onSurface"
            android:textSize="17sp"

            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cardTarefasStats" />


        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardMetasStats"

            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_marginTop="10dp"

            app:cardBackgroundColor="@color/surface_baixa"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"

            app:strokeColor="@color/primary_baixa"
            app:strokeWidth="1dp"

            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/lblMetasStats">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="vertical"

                android:padding="18dp">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:gravity="center_vertical"

                    android:orientation="horizontal">


                    <TextView
                        android:id="@+id/txtCountMetas"

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:fontFamily="@font/poppins_semibold"

                        android:text="0"

                        android:textColor="@color/primary_baixa"
                        android:textSize="30sp" />


                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:layout_marginStart="10dp"

                        android:orientation="vertical">


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:fontFamily="@font/poppins_medium"

                            android:text="Metas"

                            android:textColor="@color/onsurface_baixa"
                            android:textSize="11sp" />


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:fontFamily="@font/poppins_regular"

                            android:text="Total no período"

                            android:textColor="@color/onsurface_baixa"
                            android:textSize="9sp" />

                    </LinearLayout>

                </LinearLayout>


                <LinearLayout
                    android:id="@+id/layoutCargaMetas"

                    android:layout_width="match_parent"
                    android:layout_height="64dp"

                    android:layout_marginTop="14dp"

                    android:gravity="bottom"

                    android:orientation="horizontal"

                    android:weightSum="7" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- ===================================================== -->
        <!-- FLASHCARDS -->
        <!-- ===================================================== -->

        <TextView
            android:id="@+id/lblFlashcardsStats"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="26dp"

            android:fontFamily="@font/poppins_semibold"

            android:text="Flashcards e disciplinas"

            android:textColor="@color/onSurface"
            android:textSize="17sp"

            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cardMetasStats" />


        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardFlashcardsStats"

            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_marginTop="10dp"

            app:cardBackgroundColor="@color/primaryContainer"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"

            app:strokeColor="@color/outlineVariant"
            app:strokeWidth="1dp"

            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/lblFlashcardsStats">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="vertical"

                android:padding="18dp">


                <!-- CONTADOR -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:gravity="center_vertical"

                    android:orientation="horizontal">


                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"

                        android:contentDescription="@null"

                        android:padding="5dp"

                        android:src="@drawable/ic_card"

                        app:tint="@color/onPrimaryContainer" />


                    <TextView
                        android:id="@+id/txtCountFlashcards"

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:layout_marginStart="10dp"

                        android:fontFamily="@font/poppins_semibold"

                        android:text="0"

                        android:textColor="@color/onPrimaryContainer"
                        android:textSize="30sp" />


                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:layout_marginStart="10dp"

                        android:orientation="vertical">


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:fontFamily="@font/poppins_medium"

                            android:text="Flashcards"

                            android:textColor="@color/onPrimaryContainer"
                            android:textSize="11sp" />


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:fontFamily="@font/poppins_regular"

                            android:text="Cards estudados"

                            android:textColor="@color/onPrimaryContainer"
                            android:textSize="9sp" />

                    </LinearLayout>

                </LinearLayout>


                <!-- DOMÍNIO -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="20dp"

                    android:fontFamily="@font/poppins_medium"

                    android:text="Domínio total"

                    android:textColor="@color/onPrimaryContainer"
                    android:textSize="12sp" />


                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progressGeralFlash"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="10dp"

                    android:progress="0"

                    app:indicatorColor="@color/primary"

                    app:trackColor="@color/surface"

                    app:trackCornerRadius="4dp"
                    app:trackThickness="8dp" />


                <TextView
                    android:id="@+id/txtPercentualFlash"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_gravity="end"

                    android:layout_marginTop="5dp"

                    android:fontFamily="@font/poppins_semibold"

                    android:text="0%"

                    android:textColor="@color/onPrimaryContainer"
                    android:textSize="11sp" />


                <!-- MATÉRIAS -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="18dp"

                    android:fontFamily="@font/poppins_medium"

                    android:text="Desempenho por matéria"

                    android:textColor="@color/onPrimaryContainer"
                    android:textSize="11sp" />


                <LinearLayout
                    android:id="@+id/layoutMateriasDashboard"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="12dp"

                    android:orientation="vertical" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- ===================================================== -->
        <!-- TOTAL DE MATÉRIAS -->
        <!-- ===================================================== -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardTotalMaterias"

            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_marginTop="16dp"

            app:cardBackgroundColor="@color/secondaryContainer"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"

            app:strokeWidth="0dp"

            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cardFlashcardsStats">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:gravity="center_vertical"

                android:orientation="horizontal"

                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="14dp">


                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"

                    android:contentDescription="@null"

                    android:src="@drawable/ic_card"

                    app:tint="@color/onSecondaryContainer" />


                <TextView
                    android:id="@+id/txtMateriasEstudadas"

                    android:layout_width="0dp"
                    android:layout_height="wrap_content"

                    android:layout_marginStart="10dp"

                    android:layout_weight="1"

                    android:fontFamily="@font/poppins_medium"

                    android:text="Você focou em 0 disciplinas neste período."

                    android:textColor="@color/onSecondaryContainer"
                    android:textSize="11sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- ESPAÇO FINAL -->

        <View
            android:layout_width="0dp"
            android:layout_height="24dp"

            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cardTotalMaterias" />


    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>