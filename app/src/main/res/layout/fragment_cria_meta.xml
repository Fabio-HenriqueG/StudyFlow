<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="@color/background"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingTop="22dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp"

        tools:context=".CriaMetaFragment">


        <!-- CABEÇALHO -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardVoltarMeta"

            android:layout_width="44dp"
            android:layout_height="44dp"

            app:cardBackgroundColor="@color/surfaceVariant"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"

            app:strokeColor="@color/outlineVariant"
            app:strokeWidth="1dp"

            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">


            <ImageButton
                android:id="@+id/btnVoltar"

                android:layout_width="match_parent"
                android:layout_height="match_parent"

                android:background="@android:color/transparent"

                android:contentDescription="Voltar"

                android:padding="11dp"

                android:src="@drawable/seta_voltar"

                app:tint="@color/primary" />

        </com.google.android.material.card.MaterialCardView>


    <TextView
        android:id="@+id/textViewMeta"

        android:layout_width="0dp"
        android:layout_height="wrap_content"

        android:layout_marginEnd="12dp"

        android:fontFamily="@font/poppins_semibold"

        android:text="Criar Meta"

        android:textColor="@color/onSurface"

        android:textSize="22sp"

        app:layout_constraintBottom_toBottomOf="@+id/cardVoltarMeta"
        app:layout_constraintEnd_toStartOf="@+id/cardVoltarMeta"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/cardVoltarMeta" />


    <!-- SUBTÍTULO -->

    <TextView
        android:id="@+id/textDescricaoMeta"

        android:layout_width="0dp"
        android:layout_height="wrap_content"

        android:layout_marginTop="4dp"

        android:fontFamily="@font/poppins_regular"

        android:text="Defina um objetivo e acompanhe seu progresso"

        android:textColor="@color/onSurfaceVariant"

        android:textSize="12sp"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textViewMeta" />


    <!-- TÍTULO DA META -->

    <TextView
        android:id="@+id/lblTituloMeta"

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:layout_marginTop="28dp"

        android:fontFamily="@font/poppins_medium"

        android:text="Qual é a sua meta?"

        android:textColor="@color/onSurface"

        android:textSize="12sp"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textDescricaoMeta" />


    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layoutTituloMeta"

        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"

        android:layout_width="0dp"
        android:layout_height="wrap_content"

        android:layout_marginTop="7dp"

        android:hint="Ex.: Estudar Matemática"

        app:boxBackgroundColor="@color/edittext_surface"

        app:boxCornerRadiusBottomEnd="14dp"
        app:boxCornerRadiusBottomStart="14dp"
        app:boxCornerRadiusTopEnd="14dp"
        app:boxCornerRadiusTopStart="14dp"

        app:hintTextColor="@color/onSurfaceVariant"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/lblTituloMeta">


        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/txtTituloMeta"

            android:layout_width="match_parent"
            android:layout_height="56dp"

            android:fontFamily="@font/poppins_regular"

            android:inputType="textCapSentences"

            android:maxLines="1"

            android:textColor="@color/onSurface"

            android:textSize="13sp" />

    </com.google.android.material.textfield.TextInputLayout>


    <!-- DICA -->

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardDicaMeta"

        android:layout_width="0dp"
        android:layout_height="wrap_content"

        android:layout_marginTop="16dp"

        app:cardBackgroundColor="@color/primaryContainer"

        app:cardCornerRadius="14dp"

        app:cardElevation="0dp"

        app:strokeWidth="0dp"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutTituloMeta">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:gravity="center_vertical"

            android:orientation="horizontal"

            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp">


            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"

                android:contentDescription="@null"

                android:src="@drawable/ic_target"

                app:tint="@color/onPrimaryContainer" />


            <TextView
                android:id="@+id/textDicaMeta"

                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_marginStart="10dp"

                android:layout_weight="1"

                android:fontFamily="@font/poppins_regular"

                android:text="Ex.: Beber 3 litros de água, ler 20 páginas ou fazer exercícios."

                android:textColor="@color/onPrimaryContainer"

                android:textSize="10sp" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>


    <!-- MATÉRIA -->

    <TextView
        android:id="@+id/lblMateriaMeta"

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:layout_marginTop="24dp"

        android:fontFamily="@font/poppins_semibold"

        android:text="Matéria"

        android:textColor="@color/primary"

        android:textSize="14sp"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cardDicaMeta" />


    <TextView
        android:id="@+id/lblMateriaDescricao"

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:layout_marginTop="2dp"

        android:fontFamily="@font/poppins_regular"

        android:text="Escolha onde esta meta será organizada"

        android:textColor="@color/onSurfaceVariant"

        android:textSize="10sp"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/lblMateriaMeta" />


    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layoutMateria"

        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"

        android:layout_width="0dp"
        android:layout_height="56dp"

        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"

        android:hint="Selecionar matéria"

        app:boxBackgroundColor="@color/edittext_surface"

        app:boxCornerRadiusBottomEnd="14dp"
        app:boxCornerRadiusBottomStart="14dp"
        app:boxCornerRadiusTopEnd="14dp"
        app:boxCornerRadiusTopStart="14dp"

        app:hintTextColor="@color/onSurfaceVariant"

        app:layout_constraintEnd_toStartOf="@+id/btnNovaMateria"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/lblMateriaDescricao">


        <AutoCompleteTextView
            android:id="@+id/spinnerMaterias"

            android:layout_width="match_parent"
            android:layout_height="match_parent"

            android:fontFamily="@font/poppins_regular"

            android:inputType="none"

            android:textColor="@color/onSurface"

            android:textSize="12sp" />

    </com.google.android.material.textfield.TextInputLayout>


    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnNovaMateria"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="56dp"
        android:layout_height="56dp"
        app:backgroundTint="@color/primaryContainer"
        app:cornerRadius="16dp"
        app:icon="@android:drawable/ic_input_add"
        app:iconSize="22dp"
        app:iconTint="@color/onPrimaryContainer"
        app:layout_constraintBottom_toBottomOf="@+id/layoutMateria"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/layoutMateria" />


    <!-- SALVAR META -->

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSalvarMeta"

        android:layout_width="0dp"
        android:layout_height="56dp"

        android:layout_marginTop="28dp"

        android:fontFamily="@font/poppins_semibold"

        android:text="Começar Meta"

        android:textAllCaps="false"

        android:textColor="@color/onPrimary"

        android:textSize="13sp"

        app:backgroundTint="@color/primary"

        app:cornerRadius="16dp"

        app:icon="@drawable/ic_target"

        app:iconGravity="textStart"

        app:iconPadding="8dp"

        app:iconSize="20dp"

        app:iconTint="@color/onPrimary"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutMateria"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="1.0" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
