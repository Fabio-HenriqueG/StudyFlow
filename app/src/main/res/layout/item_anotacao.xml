<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="6dp"

    app:cardBackgroundColor="@color/surfaceVariant"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"

    app:strokeColor="@color/outlineVariant"
    app:strokeWidth="1dp">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="vertical"

        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="12dp"
        android:paddingBottom="14dp">


        <!-- TÍTULO + OPÇÕES -->

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">


            <TextView
                android:id="@+id/text_anotacao_titulo"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@id/btn_opcoes_anotacao"

                android:layout_marginEnd="8dp"

                android:ellipsize="end"
                android:maxLines="2"

                android:fontFamily="@font/poppins_semibold"

                android:text="Título da Nota"

                android:textColor="@color/onSurface"

                android:textSize="14sp" />


            <ImageButton
                android:id="@+id/btn_opcoes_anotacao"

                android:layout_width="36dp"
                android:layout_height="36dp"

                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"

                android:background="?attr/selectableItemBackgroundBorderless"

                android:contentDescription="Opções"

                android:padding="8dp"

                android:src="@drawable/ic_more_vert"

                app:tint="@color/onSurfaceVariant" />

        </RelativeLayout>
        <!-- CONTEÚDO -->

        <TextView
            android:id="@+id/text_anotacao_conteudo"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="8dp"

            android:ellipsize="end"
            android:maxLines="3"

            android:fontFamily="@font/poppins_regular"

            android:text="Este é um exemplo do conteúdo da anotação que será exibido como uma prévia..."

            android:textColor="@color/onSurfaceVariant"

            android:textSize="13sp" />

        <!-- DATA -->

        <TextView
            android:id="@+id/text_anotacao_data"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="6dp"

            android:fontFamily="@font/poppins_regular"

            android:text="Editado em 03/08/2026"

            android:textColor="@color/onSurfaceVariant"

            android:textSize="11sp" />


        <!-- TIPO -->

        <TextView
            android:id="@+id/text_anotacao_tipo"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="8dp"

            android:background="@drawable/bg_tipo_anotacao"

            android:fontFamily="@font/poppins_medium"

            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"

            android:text="Tipo"

            android:textColor="@color/onPrimaryContainer"

            android:textSize="9sp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>