<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="@color/background"

    tools:context=".AnotacoesFragment">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"

        android:paddingStart="20dp"
        android:paddingTop="22dp"
        android:paddingEnd="20dp"
        android:paddingBottom="0dp">


        <!-- TÍTULO -->

        <TextView
            android:id="@+id/textView2"

            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:fontFamily="@font/poppins_semibold"

            android:text="Anotações"

            android:textColor="@color/onSurface"

            android:textSize="22sp"

            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/cardVoltar"
            app:layout_constraintTop_toTopOf="parent" />


        <!-- BOTÃO VOLTAR -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardVoltar"

            android:layout_width="44dp"
            android:layout_height="44dp"

            android:clickable="true"
            android:focusable="true"

            android:foreground="?attr/selectableItemBackground"

            app:cardBackgroundColor="@color/surfaceVariant"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"

            app:strokeColor="@color/outlineVariant"
            app:strokeWidth="1dp"

            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent">


            <ImageButton
                android:id="@+id/btnVoltar"

                android:layout_width="match_parent"
                android:layout_height="match_parent"

                android:background="@android:color/transparent"

                android:contentDescription="Voltar"

                android:padding="11dp"

                android:src="@drawable/seta_voltar"

                app:tint="@color/primary" />

        </com.google.android.material.card.MaterialCardView>


        <!-- SUBTÍTULO -->

        <TextView
            android:id="@+id/textDescricaoAnotacoes"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="4dp"

            android:fontFamily="@font/poppins_regular"

            android:text="Acesse e organize suas anotações"

            android:textColor="@color/onSurfaceVariant"

            android:textSize="12sp"

            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textView2" />


        <!-- LISTA DE ANOTAÇÕES -->

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerAnotacoes"

            android:layout_width="0dp"
            android:layout_height="0dp"

            android:layout_marginTop="20dp"

            android:clipToPadding="false"

            android:paddingTop="2dp"
            android:paddingBottom="96dp"

            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"

            app:layout_constraintTop_toBottomOf="@id/textDescricaoAnotacoes"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"

            tools:listitem="@layout/item_anotacao" />

        <!-- ESTADO VAZIO -->

        <LinearLayout
            android:id="@+id/layoutEmptyAnotacoes"

            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone"

            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textDescricaoAnotacoes">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semibold"
                android:gravity="center"
                android:text="Nenhuma anotação criada!\nVamos criar?"
                android:textColor="@color/onSurface"
                android:textSize="14sp" />

        </LinearLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>