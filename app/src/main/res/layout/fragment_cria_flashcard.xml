<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="@color/background"

    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:paddingStart="20dp"
        android:paddingTop="22dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">


        <!-- ===================================================== -->
        <!-- CABEÇALHO -->
        <!-- ===================================================== -->

        <TextView
            android:id="@+id/lblNovoFlashcard"

            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_marginEnd="12dp"

            android:fontFamily="@font/poppins_semibold"

            android:text="Novo Flashcard"

            android:textColor="@color/onSurface"

            android:textSize="22sp"

            app:layout_constraintBottom_toBottomOf="@+id/cardVoltarFlashcard"
            app:layout_constraintEnd_toStartOf="@+id/cardVoltarFlashcard"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/cardVoltarFlashcard" />


        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardVoltarFlashcard"

            android:layout_width="44dp"
            android:layout_height="44dp"

            app:cardBackgroundColor="@color/surfaceVariant"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"

            app:strokeColor="@color/outlineVariant"
            app:strokeWidth="1dp"

            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">


            <ImageButton
                android:id="@+id/btnVoltarFlashcard"

                android:layout_width="match_parent"
                android:layout_height="match_parent"

                android:background="@android:color/transparent"

                android:contentDescription="Voltar"

                android:padding="11dp"

                android:src="@drawable/seta_voltar"

                app:tint="@color/primary" />

        </com.google.android.material.card.MaterialCardView>


        <!-- SUBTÍTULO -->

        <TextView
            android:id="@+id/lblDescricaoFlashcard"

            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_marginTop="4dp"

            android:fontFamily="@font/poppins_regular"

            android:text="Crie um cartão para revisar seus estudos"

            android:textColor="@color/onSurfaceVariant"

            android:textSize="12sp"

            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/lblNovoFlashcard" />


        <!-- ===================================================== -->
        <!-- FRENTE DO FLASHCARD -->
        <!-- ===================================================== -->

        <TextView
            android:id="@+id/lblFrenteFlashcard"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="28dp"

            android:fontFamily="@font/poppins_semibold"

            android:text="Frente"

            android:textColor="@color/primary"

            android:textSize="14sp"

            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/lblDescricaoFlashcard" />


        <TextView
            android:id="@+id/lblFrenteDescricao"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="2dp"

            android:fontFamily="@font/poppins_regular"

            android:text="Digite a pergunta que deseja estudar"

            android:textColor="@color/onSurfaceVariant"

            android:textSize="10sp"

            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/lblFrenteFlashcard" />


        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutPergunta"

            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"

            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_marginTop="10dp"

            android:hint="Pergunta"

            app:boxBackgroundColor="@color/edittext_surface"

            app:boxCornerRadiusBottomEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusTopStart="14dp"

            app:hintTextColor="@color/onSurfaceVariant"

            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/lblFrenteDescricao">


            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/txtPergunta"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:fontFamily="@font/poppins_regular"

                android:gravity="top"

                android:inputType="textMultiLine|textCapSentences"

                android:minHeight="104dp"
                android:minLines="3"

                android:textColor="@color/onSurface"

                android:textSize="13sp" />

        </com.google.android.material.textfield.TextInputLayout>


        <!-- ===================================================== -->
        <!-- VERSO DO FLASHCARD -->
        <!-- ===================================================== -->

        <TextView
            android:id="@+id/lblVersoFlashcard"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="22dp"

            android:fontFamily="@font/poppins_semibold"

            android:text="Verso"

            android:textColor="@color/primary"

            android:textSize="14sp"

            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layoutPergunta" />


        <TextView
            android:id="@+id/lblVersoDescricao"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="2dp"

            android:fontFamily="@font/poppins_regular"

            android:text="Informe a resposta correta"

            android:textColor="@color/onSurfaceVariant"

            android:textSize="10sp"

            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/lblVersoFlashcard" />


        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutResposta"

            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"

            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_marginTop="10dp"

            android:hint="Resposta"

            app:boxBackgroundColor="@color/edittext_surface"

            app:boxCornerRadiusBottomEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusTopStart="14dp"

            app:hintTextColor="@color/onSurfaceVariant"

            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/lblVersoDescricao">


            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/txtResposta"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:fontFamily="@font/poppins_regular"

                android:gravity="top"

                android:inputType="textMultiLine|textCapSentences"

                android:minHeight="104dp"
                android:minLines="3"

                android:textColor="@color/onSurface"

                android:textSize="13sp" />

        </com.google.android.material.textfield.TextInputLayout>


        <!-- ===================================================== -->
        <!-- EXPLICAÇÃO -->
        <!-- ===================================================== -->

        <TextView
            android:id="@+id/lblExplicacaoFlashcard"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="22dp"

            android:fontFamily="@font/poppins_medium"

            android:text="Explicação"

            android:textColor="@color/onSurface"

            android:textSize="12sp"

            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layoutResposta" />


        <TextView
            android:id="@+id/lblExplicacaoOpcional"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:fontFamily="@font/poppins_regular"

            android:text="Opcional"

            android:textColor="@color/onSurfaceVariant"

            android:textSize="10sp"

            app:layout_constraintBottom_toBottomOf="@+id/lblExplicacaoFlashcard"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/lblExplicacaoFlashcard" />


        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutExplicacao"

            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"

            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_marginTop="8dp"

            android:hint="Adicione uma explicação para a resposta"

            app:boxBackgroundColor="@color/edittext_surface"

            app:boxCornerRadiusBottomEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusTopStart="14dp"

            app:hintTextColor="@color/onSurfaceVariant"

            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/lblExplicacaoFlashcard">


            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/txtExplicacao"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:fontFamily="@font/poppins_regular"

                android:gravity="top"

                android:inputType="textMultiLine|textCapSentences"

                android:minHeight="88dp"
                android:minLines="2"

                android:textColor="@color/onSurface"

                android:textSize="13sp" />

        </com.google.android.material.textfield.TextInputLayout>


        <!-- ===================================================== -->
        <!-- MATÉRIA -->
        <!-- ===================================================== -->

        <TextView
            android:id="@+id/lblMateriaFlashcard"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="24dp"

            android:fontFamily="@font/poppins_semibold"

            android:text="Matéria"

            android:textColor="@color/primary"

            android:textSize="14sp"

            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layoutExplicacao" />


        <TextView
            android:id="@+id/lblMateriaDescricao"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="2dp"

            android:fontFamily="@font/poppins_regular"

            android:text="Escolha onde este flashcard será organizado"

            android:textColor="@color/onSurfaceVariant"

            android:textSize="10sp"

            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/lblMateriaFlashcard" />


        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutMateria"

            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"

            android:layout_width="0dp"
            android:layout_height="56dp"

            android:layout_marginTop="10dp"
            android:layout_marginEnd="10dp"

            android:hint="Selecionar matéria"

            app:boxBackgroundColor="@color/edittext_surface"

            app:boxCornerRadiusBottomEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusTopStart="14dp"

            app:hintTextColor="@color/onSurfaceVariant"

            app:layout_constraintEnd_toStartOf="@+id/btnNovaMateria"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/lblMateriaDescricao">


            <AutoCompleteTextView
                android:id="@+id/spinnerMaterias"

                android:layout_width="match_parent"
                android:layout_height="match_parent"

                android:fontFamily="@font/poppins_regular"

                android:inputType="none"

                android:textColor="@color/onSurface"

                android:textSize="12sp" />

        </com.google.android.material.textfield.TextInputLayout>


        <!-- NOVA MATÉRIA -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNovaMateria"

            style="@style/Widget.Material3.Button.IconButton"

            android:layout_width="56dp"
            android:layout_height="56dp"

            android:contentDescription="Adicionar nova matéria"

            app:backgroundTint="@color/primaryContainer"

            app:cornerRadius="16dp"

            app:icon="@android:drawable/ic_input_add"

            app:iconSize="22dp"

            app:iconTint="@color/onPrimaryContainer"

            app:layout_constraintBottom_toBottomOf="@+id/layoutMateria"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/layoutMateria" />


        <!-- ===================================================== -->
        <!-- DICA -->
        <!-- ===================================================== -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardDicaFlashcard"

            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_marginTop="20dp"

            app:cardBackgroundColor="@color/primaryContainer"

            app:cardCornerRadius="14dp"

            app:cardElevation="0dp"

            app:strokeWidth="0dp"

            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layoutMateria">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:gravity="center_vertical"

                android:orientation="horizontal"

                android:paddingStart="14dp"
                android:paddingTop="12dp"
                android:paddingEnd="14dp"
                android:paddingBottom="12dp">


                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"

                    android:contentDescription="@null"

                    android:src="@drawable/ic_card"

                    app:tint="@color/onPrimaryContainer" />


                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"

                    android:layout_marginStart="10dp"

                    android:layout_weight="1"

                    android:fontFamily="@font/poppins_regular"

                    android:text="Perguntas curtas e respostas objetivas facilitam a revisão."

                    android:textColor="@color/onPrimaryContainer"

                    android:textSize="10sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- ===================================================== -->
        <!-- CRIAR FLASHCARD -->
        <!-- ===================================================== -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSalvarFlashcard"

            android:layout_width="0dp"
            android:layout_height="56dp"

            android:layout_marginTop="24dp"

            android:fontFamily="@font/poppins_semibold"

            android:text="Criar Flashcard"

            android:textAllCaps="false"

            android:textColor="@color/onPrimary"

            android:textSize="13sp"

            app:backgroundTint="@color/primary"

            app:cornerRadius="16dp"

            app:icon="@drawable/ic_card"

            app:iconGravity="textStart"

            app:iconPadding="8dp"

            app:iconSize="20dp"

            app:iconTint="@color/onPrimary"

            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cardDicaFlashcard" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>