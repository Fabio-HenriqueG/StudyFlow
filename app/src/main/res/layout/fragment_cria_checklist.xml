<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="@color/background"

    android:paddingStart="20dp"
    android:paddingTop="22dp"
    android:paddingEnd="20dp"
    android:paddingBottom="20dp"

    tools:context=".CriaChecklistFragment">


    <!-- ===================================================== -->
    <!-- CABEÇALHO -->
    <!-- ===================================================== -->

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardVoltarChecklist"

        android:layout_width="44dp"
        android:layout_height="44dp"

        app:cardBackgroundColor="@color/surfaceVariant"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"

        app:strokeColor="@color/outlineVariant"
        app:strokeWidth="1dp"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">


        <ImageButton
            android:id="@+id/btnVoltar"

            android:layout_width="match_parent"
            android:layout_height="match_parent"

            android:background="@android:color/transparent"

            android:contentDescription="Voltar"

            android:padding="11dp"

            android:src="@drawable/seta_voltar"

            app:tint="@color/primary" />

    </com.google.android.material.card.MaterialCardView>


    <TextView
        android:id="@+id/textViewCriaChecklist"

        android:layout_width="0dp"
        android:layout_height="wrap_content"

        android:layout_marginEnd="12dp"

        android:fontFamily="@font/poppins_semibold"

        android:text="Criar Checklist"

        android:textColor="@color/onSurface"

        android:textSize="22sp"

        app:layout_constraintBottom_toBottomOf="@+id/cardVoltarChecklist"
        app:layout_constraintEnd_toStartOf="@+id/cardVoltarChecklist"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/cardVoltarChecklist" />


    <!-- SUBTÍTULO -->

    <TextView
        android:id="@+id/textDescricaoCriaChecklist"

        android:layout_width="0dp"
        android:layout_height="wrap_content"

        android:layout_marginTop="4dp"

        android:fontFamily="@font/poppins_regular"

        android:text="Organize seus estudos em uma lista de tópicos"

        android:textColor="@color/onSurfaceVariant"

        android:textSize="12sp"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textViewCriaChecklist" />


    <!-- ===================================================== -->
    <!-- TÍTULO DO CHECKLIST -->
    <!-- ===================================================== -->

    <TextView
        android:id="@+id/lblTituloChecklist"

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:layout_marginTop="28dp"

        android:fontFamily="@font/poppins_semibold"

        android:text="Título"

        android:textColor="@color/onSurface"

        android:textSize="12sp"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textDescricaoCriaChecklist" />


    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layoutTituloChecklist"

        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"

        android:layout_width="0dp"
        android:layout_height="wrap_content"

        android:layout_marginTop="7dp"

        android:hint="Ex.: Estudos para a prova"

        app:boxBackgroundColor="@color/edittext_surface"

        app:boxCornerRadiusBottomEnd="14dp"
        app:boxCornerRadiusBottomStart="14dp"
        app:boxCornerRadiusTopEnd="14dp"
        app:boxCornerRadiusTopStart="14dp"

        app:hintTextColor="@color/onSurfaceVariant"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/lblTituloChecklist">


        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editTituloChecklist"

            android:layout_width="match_parent"
            android:layout_height="56dp"

            android:fontFamily="@font/poppins_regular"

            android:inputType="textCapSentences"

            android:maxLines="1"

            android:textColor="@color/onSurface"

            android:textSize="13sp" />

    </com.google.android.material.textfield.TextInputLayout>


    <!-- ===================================================== -->
    <!-- OPÇÕES -->
    <!-- ===================================================== -->

    <TextView
        android:id="@+id/lblOpcoesChecklist"

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:layout_marginTop="24dp"

        android:fontFamily="@font/poppins_semibold"

        android:text="Opções"

        android:textColor="@color/primary"

        android:textSize="14sp"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutTituloChecklist" />


    <!-- FIXAR NO TOPO -->

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardFixarChecklist"

        android:layout_width="0dp"
        android:layout_height="60dp"

        android:layout_marginTop="10dp"

        app:cardBackgroundColor="@color/surfaceVariant"

        app:cardCornerRadius="16dp"

        app:cardElevation="0dp"

        app:strokeColor="@color/outlineVariant"
        app:strokeWidth="1dp"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/lblOpcoesChecklist">


        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchFixar"

            android:layout_width="match_parent"
            android:layout_height="match_parent"

            android:fontFamily="@font/poppins_medium"

            android:paddingStart="16dp"
            android:paddingEnd="12dp"

            android:text="Fixar no topo"

            android:textColor="@color/onSurface"

            android:textSize="12sp" />

    </com.google.android.material.card.MaterialCardView>


    <!-- ===================================================== -->
    <!-- DATA DE VALIDADE -->
    <!-- ===================================================== -->

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDataValidade"

        style="@style/Widget.Material3.Button.TonalButton"

        android:layout_width="0dp"
        android:layout_height="56dp"

        android:layout_marginTop="10dp"

        android:fontFamily="@font/poppins_medium"

        android:gravity="center_vertical"

        android:paddingStart="16dp"
        android:paddingEnd="16dp"

        android:text="Definir data de validade"

        android:textAllCaps="false"

        android:textColor="@color/onPrimaryContainer"

        android:textSize="12sp"

        app:backgroundTint="@color/primaryContainer"

        app:cornerRadius="16dp"

        app:icon="@android:drawable/ic_menu_today"

        app:iconGravity="textStart"

        app:iconPadding="12dp"

        app:iconSize="20dp"

        app:iconTint="@color/onPrimaryContainer"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cardFixarChecklist" />


    <!-- TEXTO AUXILIAR -->

    <TextView
        android:id="@+id/textAjudaData"

        android:layout_width="0dp"
        android:layout_height="wrap_content"

        android:layout_marginStart="4dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="4dp"

        android:fontFamily="@font/poppins_regular"

        android:text="Opcional • Você pode definir um prazo para concluir a lista"

        android:textColor="@color/onSurfaceVariant"

        android:textSize="10sp"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnDataValidade" />


    <!-- ===================================================== -->
    <!-- ITENS DO CHECKLIST -->
    <!-- ===================================================== -->

    <TextView
        android:id="@+id/lblItensChecklist"

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:layout_marginTop="24dp"

        android:fontFamily="@font/poppins_semibold"

        android:text="Itens da lista"

        android:textColor="@color/primary"

        android:textSize="14sp"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textAjudaData" />


    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAdicionarItem"

        style="@style/Widget.Material3.Button.TextButton"

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:fontFamily="@font/poppins_medium"

        android:text="Adicionar item"

        android:textAllCaps="false"

        android:textSize="12sp"

        app:icon="@android:drawable/ic_input_add"

        app:layout_constraintBottom_toBottomOf="@+id/lblItensChecklist"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/lblItensChecklist" />


    <!-- ===================================================== -->
    <!-- SALVAR -->
    <!-- ===================================================== -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvItensChecklist"

        android:layout_width="0dp"
        android:layout_height="0dp"

        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp"

        android:clipToPadding="false"

        android:overScrollMode="never"

        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"

        app:layout_constraintBottom_toTopOf="@+id/btnSalvarChecklist"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/lblItensChecklist"
        app:layout_constraintVertical_bias="0.0"
        tools:listitem="@android:layout/simple_list_item_2" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSalvarChecklist"

        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginBottom="4dp"

        android:fontFamily="@font/poppins_semibold"

        android:text="Criar Checklist"

        android:textAllCaps="false"

        android:textColor="@color/onPrimary"

        android:textSize="13sp"

        app:backgroundTint="@color/primary"

        app:cornerRadius="16dp"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>