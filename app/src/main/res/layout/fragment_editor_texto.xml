<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <!-- Barra de Topo -->
    <LinearLayout
        android:id="@+id/topBarTexto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:gravity="center_vertical"
        android:background="?attr/colorSurface"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnVoltarTexto"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/seta_voltar"
            app:tint="?attr/colorOnSurface" />

        <EditText
            android:id="@+id/editTituloTexto"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@null"
            android:hint="Título da Nota"
            android:textColor="?attr/colorOnSurface"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnSalvarTexto"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_check"
            app:tint="?attr/colorPrimary" />
    </LinearLayout>

    <EditText
        android:id="@+id/editConteudoTexto"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:padding="16dp"
        android:gravity="top"
        android:hint="Comece a escrever..."
        android:background="@null"
        android:textColor="?attr/colorOnSurface"
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@id/topBarTexto"
        app:layout_constraintBottom_toTopOf="@id/toolbarFormatacao"/>

    <!-- Barra de Formatação (Movida para baixo) -->
    <HorizontalScrollView
        android:id="@+id/toolbarFormatacao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceVariant"
        android:padding="4dp"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btnNegrito"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_menu_edit"
                android:contentDescription="Negrito"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="?attr/colorOnSurfaceVariant" />

            <ImageButton
                android:id="@+id/btnItalico"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_menu_edit"
                android:contentDescription="Itálico"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="?attr/colorOnSurfaceVariant" />

            <ImageButton
                android:id="@+id/btnSublinhado"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_menu_edit"
                android:contentDescription="Sublinhado"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="?attr/colorOnSurfaceVariant" />

            <View
                android:layout_width="1dp"
                android:layout_height="24dp"
                android:background="?attr/colorOutline"
                android:layout_marginHorizontal="8dp" />

            <ImageButton
                android:id="@+id/btnCorTexto"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_menu_compass"
                android:contentDescription="Cor"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="?attr/colorOnSurfaceVariant" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tamanho:"
                android:textSize="12sp"
                android:layout_marginStart="8dp"/>

            <SeekBar
                android:id="@+id/seekBarTamanhoFonte"
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:max="40"
                android:progress="18" />

        </LinearLayout>
    </HorizontalScrollView>



</androidx.constraintlayout.widget.ConstraintLayout>
