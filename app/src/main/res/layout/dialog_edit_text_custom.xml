<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:orientation="vertical"

    android:background="@color/surface"
    android:paddingStart="20dp"
    android:paddingTop="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="20dp">


    <!-- ===================================================== -->
    <!-- CAMPO PRINCIPAL DE TEXTO -->
    <!-- ===================================================== -->

    <EditText
        android:id="@+id/editTextoDialog"

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:minHeight="130dp"

        android:background="@drawable/shape_edit_text"

        android:fontFamily="@font/poppins_medium"

        android:gravity="top|start"

        android:hint="Escreva algo..."

        android:inputType="textMultiLine|textCapSentences"

        android:minLines="3"
        android:maxLines="6"

        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp"

        android:scrollbars="vertical"

        android:textColor="@color/onSurface"
        android:textColorHint="@color/onSurfaceVariant"

        android:textSize="16sp" />


    <!-- ===================================================== -->
    <!-- TAMANHO DO TEXTO -->
    <!-- ===================================================== -->

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:layout_marginTop="20dp"

        android:fontFamily="@font/poppins_semibold"

        android:text="Tamanho do texto"

        android:textColor="@color/onSurface"
        android:textSize="13sp" />


    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:layout_marginTop="2dp"

        android:fontFamily="@font/poppins_regular"

        android:text="Ajuste o tamanho da escrita"

        android:textColor="@color/onSurfaceVariant"
        android:textSize="11sp" />


    <!-- SeekBar + valor exato -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:layout_marginTop="8dp"

        android:gravity="center_vertical"
        android:orientation="horizontal">


        <SeekBar
            android:id="@+id/seekBarTamanhoTexto"

            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_weight="1"

            android:max="100"
            android:progress="24"

            android:progressTint="@color/primary"
            android:progressBackgroundTint="@color/outlineVariant"

            android:splitTrack="false"

            android:thumbTint="@color/primary" />


        <!-- VALOR EXATO -->

        <EditText
            android:id="@+id/editTamanhoTexto"

            android:layout_width="58dp"
            android:layout_height="44dp"

            android:layout_marginStart="12dp"

            android:background="@drawable/shape_edit_text"

            android:fontFamily="@font/poppins_semibold"

            android:gravity="center"

            android:inputType="number"
            android:maxLength="3"

            android:padding="4dp"

            android:text="12"

            android:textColor="@color/onSurface"

            android:textSize="13sp" />

    </LinearLayout>


    <!-- ===================================================== -->
    <!-- COR PERSONALIZADA -->
    <!-- ===================================================== -->

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:layout_marginTop="20dp"

        android:fontFamily="@font/poppins_semibold"

        android:text="Cor do texto"

        android:textColor="@color/onSurface"

        android:textSize="13sp" />


    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:layout_marginTop="2dp"

        android:fontFamily="@font/poppins_regular"

        android:text="Escolha uma cor personalizada"

        android:textColor="@color/onSurfaceVariant"

        android:textSize="11sp" />


    <SeekBar
        android:id="@+id/seekBarCorArcoIris"

        android:layout_width="match_parent"
        android:layout_height="32dp"

        android:layout_marginTop="8dp"

        android:max="360"

        android:progressDrawable="@null"

        android:thumb="@android:drawable/btn_default"
        android:thumbTint="@color/primary" />


    <!-- ===================================================== -->
    <!-- CORES RÁPIDAS -->
    <!-- ===================================================== -->

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:layout_marginTop="20dp"

        android:fontFamily="@font/poppins_semibold"

        android:text="Cores rápidas"

        android:textColor="@color/onSurface"

        android:textSize="13sp" />


    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:layout_marginTop="2dp"

        android:fontFamily="@font/poppins_regular"

        android:text="Selecione uma das opções"

        android:textColor="@color/onSurfaceVariant"

        android:textSize="11sp" />


    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:layout_marginTop="10dp"

        android:fillViewport="false"

        android:scrollbars="none">


        <LinearLayout
            android:id="@+id/layoutCoresTexto"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:gravity="center_vertical"

            android:orientation="horizontal"

            android:paddingEnd="4dp" />

    </HorizontalScrollView>

</LinearLayout>